# Supabase — copy from: supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Site URL — used for redirects (http://localhost:3000 for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Visitor portfolio password — required to view the public site
# Can also be changed at runtime via /admin/settings (stored in Supabase)
PORTFOLIO_PASSWORD=your_portfolio_password_here

# Admin CMS password — protects the /admin area
ADMIN_PASSWORD=your_admin_password_here
